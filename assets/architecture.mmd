flowchart LR

  subgraph FRONTEND["🖥️ Frontend (React / Vite)"]
    direction TB
    U["User submits\nnatural-language\nquestion"]
    DISPLAY["Display Results\n─────────────\nSQL · Table · Chart\nAnalysis"]
  end

  subgraph API["⚡ FastAPI Backend"]
    direction TB
    EP["/api/query\nPOST endpoint"]
    SSE["SSE Stream\n(text/event-stream)\n─────────────\nsql → data → chart\nanalysis → done"]
  end

  subgraph STARTUP["🔧 App Startup"]
    direction TB
    SCHEMA_LOAD["Schema\nIntrospection"]
    GRAPH_BUILD["Compile\nLangGraph\nPipeline"]
  end

  subgraph LANGGRAPH["🧠 LangGraph Orchestration Pipeline"]
    direction TB

    GEN_SQL["generate_sql\n─────────────\nLLM: NL → SQL\n+ schema context\n+ domain rules\n+ similar examples\n+ timezone context"]

    VAL_SQL["validate_sql\n─────────────\nRegex safety gate\nForbidden keyword\ncheck · LIMIT\ninjection"]

    ROUTE1{Safe?}

    EXEC_SQL["execute_sql\n─────────────\nSQLAlchemy\npd.read_sql()\nDataFrame"]

    ROUTE2{Has Data?}

    subgraph PARALLEL["⚡ Parallel Execution"]
      direction LR
      GEN_CHART["generate_chart\n─────────────\nLLM → Plotly code\nSandboxed exec()\nfig.to_json()"]
      GEN_ANALYSIS["generate_analysis\n─────────────\nLLM: Data → Insight\nStatistical context\nActionable summary"]
    end

    ERR_EXIT["error_exit\n❌ Error response"]
    NO_DATA["no_data_exit\n📭 Empty result"]
  end

  subgraph RETRIEVAL["📚 Retrieval & Context"]
    direction TB
    CHROMA[("ChromaDB\n(sql_examples)\n─────────────\n35 Q→SQL pairs\n8 glossary entries")]
    CACHE_HIT{"Semantic Cache\ndistance < 0.1?"}
  end

  subgraph DATABASE["🗄️ Data Layer"]
    direction TB
    PG[("PostgreSQL\n─────────────\nIoT telemetry\nnotifications\ndevice · enterprise")]
    SCHEMA_SRC[("information_schema\n─────────────\nTable DDL\nColumn types\nRow counts")]
  end

  subgraph LLM_SVC["🤖 LLM Service"]
    LLM["LLM API\n(OpenAI-compatible)"]
  end

  %% ── Flow ─────────────────────────────────────────────────
  U -->|"HTTP POST\n{question, history,\ntimezone}"| EP
  EP --> GEN_SQL

  GEN_SQL -->|"query\ntop-5"| CHROMA
  CHROMA -->|"similar Q→SQL\n+ glossary"| GEN_SQL
  GEN_SQL -->|"check\ncache hit"| CACHE_HIT
  CACHE_HIT -->|"Yes: reuse SQL"| VAL_SQL
  CACHE_HIT -->|"No: call LLM"| LLM
  LLM -->|"generated SQL"| VAL_SQL

  VAL_SQL --> ROUTE1
  ROUTE1 -->|"✅ Valid"| EXEC_SQL
  ROUTE1 -->|"❌ Unsafe"| ERR_EXIT

  EXEC_SQL -->|"SQLAlchemy"| PG
  PG -->|"result rows"| EXEC_SQL

  EXEC_SQL --> ROUTE2
  ROUTE2 -->|"✅ rows > 0"| PARALLEL
  ROUTE2 -->|"📭 empty"| NO_DATA
  ROUTE2 -->|"❌ error"| ERR_EXIT

  GEN_CHART -->|"df + question"| LLM
  GEN_ANALYSIS -->|"df + stats"| LLM

  PARALLEL --> SSE
  ERR_EXIT --> SSE
  NO_DATA --> SSE
  SSE -->|"event: sql\nevent: data\nevent: chart\nevent: analysis\nevent: done"| DISPLAY

  SCHEMA_SRC -->|"DDL + counts"| SCHEMA_LOAD
  SCHEMA_LOAD -->|"schema_context"| GRAPH_BUILD
  GRAPH_BUILD -.->|"compiled graph\n(app startup)"| EP

  %% ── Styling ──────────────────────────────────────────────
  classDef frontend fill:#eff6ff,stroke:#3b82f6,stroke-width:2px,color:#1e3a5f
  classDef api fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#78350f
  classDef graph fill:#f0f9ff,stroke:#4f46e5,stroke-width:2px,color:#312e81
  classDef parallel fill:#ecfdf5,stroke:#10b981,stroke-width:2px,color:#064e3b
  classDef retrieval fill:#faf5ff,stroke:#8b5cf6,stroke-width:2px,color:#4c1d95
  classDef database fill:#fff1f2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d
  classDef llm fill:#fdf4ff,stroke:#d946ef,stroke-width:2px,color:#701a75
  classDef error fill:#fef2f2,stroke:#dc2626,stroke-width:1px,color:#991b1b
  classDef decision fill:#fefce8,stroke:#ca8a04,stroke-width:2px,color:#713f12

  class U,DISPLAY frontend
  class EP,SSE api
  class GEN_SQL,VAL_SQL,EXEC_SQL graph
  class GEN_CHART,GEN_ANALYSIS parallel
  class CHROMA,CACHE_HIT retrieval
  class PG,SCHEMA_SRC database
  class LLM llm
  class ERR_EXIT,NO_DATA error
  class ROUTE1,ROUTE2 decision
  class SCHEMA_LOAD,GRAPH_BUILD api

